<style>
.hv{--o:#ef662f;--oh:#d4551f;--ol:#ff7a3d;--ink:#333333;--body:#333333;--mut:#666666;--soft:#f8f8f8;--tint:#fdf0eb;--line:#e0e0e0;--dark:#14161c;--dline:#2e313a;font-family:'DM Sans',sans-serif;color:var(--body)}
.hv *{box-sizing:border-box}
.hv section{padding:112px 40px}
.hv .in{max-width:1180px;margin:0 auto}
.hv p{margin:0;text-wrap:pretty}
.hv .big,.hv .lead{text-wrap:balance}
.hv a{color:var(--o);font-weight:700;text-decoration:none;transition:color .18s}
.hv a:hover{color:var(--oh)}
.hv .dark a:not(.btn):hover{color:var(--ol)}
.hv a:focus-visible,.hv button:focus-visible,.hv summary:focus-visible,.hv input:focus-visible{outline:3px solid var(--o);outline-offset:3px;border-radius:4px}
.hv a:active,.hv button:active{transform:translateY(1px)}
.hv .tl .ar{display:inline-block;transition:transform .18s;margin-left:2px}
.hv .tl:hover .ar{transform:translateX(4px)}
.hv .eb{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--o);margin:0 0 14px}
.hv h1,.hv h2,.hv h3{font-family:'Plus Jakarta Sans',sans-serif;color:var(--ink);margin:0;text-wrap:balance}
.hv h2{font-weight:800;font-size:clamp(30px,3.4vw,44px);line-height:1.1;letter-spacing:-.8px;margin:0 0 18px;max-width:900px}
.hv h2 .o,.hv h1 .o{color:var(--o)}
.hv h3{font-weight:800;font-size:21px;line-height:1.3}
.hv .lead{font-size:clamp(17px,1.4vw,19px);line-height:1.6;margin:0 0 44px;max-width:780px}
.hv .lead b{color:var(--ink)}
.hv .light{background:#fff}.hv .soft{background:var(--soft)}.hv .dark{background:var(--dark);color:#dfe2e7}
.hv .dark h1,.hv .dark h2,.hv .dark h3{color:#fff}.hv .dark .lead{color:#dfe2e7}.hv .dark .lead b{color:#fff}
.hv .btn{display:inline-block;background:var(--o);color:#fff!important;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:17px;padding:15px 24px;border-radius:8px;border:2px solid var(--o);transition:transform .18s,box-shadow .18s,background .18s;white-space:nowrap}
.hv .btn .ar{display:inline-block;transition:transform .18s;margin-left:4px}
.hv .btn:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(239,102,47,.32);background:var(--oh);border-color:var(--oh)}
.hv .btn:hover .ar{transform:translateX(4px)}
.hv .btn.ghost{background:transparent}
.hv .btn.ghost:hover{background:rgba(239,102,47,.12);border-color:var(--o)}
.hv .light .btn.ghost,.hv .soft .btn.ghost{color:var(--ink)!important}
.hv .illus{margin:0 0 18px;font-size:15px;color:var(--mut);line-height:1.5}.hv .illus b{color:var(--ink)}
.hv .cpb .pth{display:flex;flex-wrap:wrap;align-items:center;gap:2px 0;font-weight:500}.hv .cpb .pth i{font-style:normal;color:var(--o);font-weight:700;margin:0 8px}.hv .cpb .pth span:first-child i{display:none}.hv .cpb .pth span{white-space:nowrap}
.hv .take{margin:22px 0 0;font-size:17px;line-height:1.6;color:var(--body);max-width:900px}.hv .take b{color:var(--ink);font-weight:700}
.hv .how{margin:18px 0 0;max-width:900px}
.hv .how summary{cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:15px;color:var(--ink);display:inline-flex;align-items:center;gap:8px;padding:6px 0}
.hv .how summary::-webkit-details-marker{display:none}.hv .how summary::marker{content:''}
.hv .how summary::after{content:'+';color:var(--o);font-size:18px;line-height:1;transition:transform .18s}
.hv .how[open] summary::after{transform:rotate(45deg)}
.hv .how summary:hover{color:var(--o)}
.hv .how p{font-size:15px;color:var(--mut);line-height:1.6;margin:8px 0 0}
.hv .insight{margin:0;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(22px,2.2vw,30px);line-height:1.25;letter-spacing:-.5px;color:var(--ink);max-width:860px;text-wrap:balance}
.hv .read{margin:14px 0 0}
.hv .path{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:#fff}
.hv .path li{position:relative;padding:28px 26px 30px;border-left:1px solid var(--line);transition:background .18s}
.hv .path li:first-child{border-left:0}
.hv .path li:hover{background:var(--tint)}
.hv .path li:not(:last-child)::after{content:'';position:absolute;right:-9px;top:34px;width:16px;height:16px;background:inherit;border-top:1px solid var(--line);border-right:1px solid var(--line);transform:rotate(45deg);z-index:1;background:#fff}
.hv .path li:hover::after{background:var(--tint)}
.hv .path .st{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:var(--mut);margin-bottom:14px}
.hv .path b{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(21px,1.7vw,25px);letter-spacing:-.5px;color:var(--o);line-height:1.1;margin-bottom:8px}
.hv .path h3{font-size:18px;margin:0 0 10px}
.hv .path p{font-size:16px;line-height:1.55}
.hv .path .src{display:block;color:var(--mut);font-size:13px;margin-top:10px}
.hv .grp{font-family:'Plus Jakarta Sans',sans-serif;font-size:14px;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:var(--o);margin:48px 0 14px}
.hv #proof .lead+.grp{margin-top:36px}
.hv #system h2,.hv #system .lead{text-align:center;margin-left:auto;margin-right:auto}
.hv .sv-diag2{max-width:1000px;margin:48px auto 0}
.hv .sv-duo{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.hv .sv-dcard{background:#fff;border:1px solid #333;border-radius:14px;padding:34px 32px 28px;display:flex;flex-direction:column;transition:transform .18s,box-shadow .18s}
.hv .sv-dcard.team{border-color:var(--o)}
.hv .sv-dcard:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(17,19,24,.08)}
.hv .sv-dnum{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:var(--o);margin:0 0 14px}
.hv .sv-dcard h3{font-size:clamp(24px,2.2vw,30px);letter-spacing:-.6px;margin:0 0 18px}
.hv .sv-dlist{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:10px 24px;flex:1;align-content:start}
.hv .sv-dlist li{position:relative;padding-left:16px;font-size:17px}
.hv .sv-dlist li::before{content:'';position:absolute;left:0;top:.62em;width:6px;height:6px;background:var(--o)}
.hv .sv-dlist a{color:var(--ink);font-weight:500}.hv .sv-dlist a:hover{color:var(--o)}
.hv .sv-dwho{margin:22px 0 0;padding-top:18px;border-top:1px solid var(--line);font-size:15px;color:var(--mut);line-height:1.55}
.hv .sv-dwho b{display:block;color:var(--ink)}
.hv .sv-merge{display:block;width:100%;height:64px}
.hv .sv-stem{display:none}
.hv .sv-measure{background:#333;border-radius:14px;max-width:640px;margin:0 auto;padding:34px 32px;text-align:center;box-shadow:0 18px 40px rgba(17,19,24,.12)}
.hv .sv-measure .mk{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:var(--o);margin:0 0 10px}
.hv .sv-measure .mt{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(24px,2.3vw,30px);letter-spacing:-.6px;color:#fff;margin:0 0 10px;text-wrap:balance}
.hv .sv-measure .md{color:#d1d5db;font-size:17px;line-height:1.55;text-wrap:balance;max-width:440px;margin:0 auto}
.hv .sv-dcap{text-align:center;color:var(--mut);font-size:17px;margin:28px 0 0}
.hv .sv-dmore{text-align:center;margin:12px 0 0;font-size:17px}
@media(max-width:700px){.hv .sv-duo{grid-template-columns:1fr;gap:14px}.hv .sv-merge{display:none}.hv .sv-stem{display:block;width:2px;height:36px;background:var(--o);margin:0 auto}.hv .sv-dcard{padding:26px 22px 22px}.hv .sv-measure{padding:28px 22px}}
.hv .tlax{display:flex;justify-content:space-between;font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:var(--mut);margin:48px 0 14px}
.hv .tlax span:last-child{color:var(--o)}
.hv .tline{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(7,1fr);gap:0 16px;position:relative}
.hv .tline::before{content:'';position:absolute;left:0;right:0;top:21px;height:4px;border-radius:2px;background:linear-gradient(90deg,var(--line),var(--o))}
.hv .tn{position:relative;z-index:1;display:grid;place-items:center;width:46px;height:46px;border-radius:50%;background:#fff;border:2px solid var(--o);font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:15px;color:var(--o);margin-bottom:18px;transition:background .18s,color .18s,box-shadow .18s}
.hv .tline li{display:contents}
.hv .tb{margin:0;font-size:inherit}
.hv .tb button{all:unset;box-sizing:border-box;cursor:pointer;display:flex;flex-direction:column;align-items:flex-start;width:100%;height:100%;padding:0 4px 18px;border-radius:10px;transition:transform .18s}
.hv .tb button:hover{transform:translateY(-3px)}
.hv .tb button:focus-visible{outline:2px solid var(--o);outline-offset:4px}
.hv .tb button:hover .tn,.hv .tb button[aria-expanded="true"] .tn{background:var(--o);color:#fff;box-shadow:0 0 0 6px var(--tint)}
.hv .tw{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:14px;font-weight:800;color:var(--o);margin:0 0 6px}
.hv .th{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:17px;line-height:1.3;color:var(--ink);margin:0 0 8px;text-wrap:balance}
.hv .tb button[aria-expanded="true"] .th{color:var(--o)}
.hv .tx{display:block;font-family:'DM Sans',sans-serif;font-weight:400;font-size:15px;color:var(--mut);line-height:1.45}
.hv .tp{grid-column:1/-1;grid-row:2;margin:18px 0 0;background:var(--tint);border-left:3px solid var(--o);border-radius:0 12px 12px 0;padding:26px 30px;animation:tpIn .25s ease}
.hv .tp[data-closed]{display:none}
.hv .tp p{font-size:17px;line-height:1.65;max-width:860px}
.hv .tp .tsrc{font-size:13px;line-height:1.5;color:#666;margin:12px 0 0}
.hv .tp .tph{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#333;margin:0 0 6px}
.hv .tp .tpw{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:var(--o);margin:0 0 8px}
@keyframes tpIn{from{opacity:.4;transform:translateY(4px)}to{opacity:1;transform:none}}
.hv .tlhint{margin:16px 0 0;font-size:15px;color:var(--mut)}
@media(max-width:1100px){.hv .tlax{display:none}.hv .tline{grid-template-columns:1fr;gap:0;margin-top:40px}.hv .tline::before{left:21px;right:auto;top:0;bottom:0;width:4px;height:auto;background:linear-gradient(180deg,var(--line),var(--o))}.hv .tline li{display:block;position:relative;padding:0 0 22px}.hv .tline li:last-child{padding-bottom:0}.hv .tb button{display:grid;grid-template-columns:46px 1fr;column-gap:20px;padding:0;align-items:start}.hv .tn{grid-row:1/4;margin:0}.hv .tw,.hv .th,.hv .tx{grid-column:2}.hv .tb button:hover{transform:translateX(3px)}.hv .th{font-size:19px}.hv .tp{grid-row:auto;margin:14px 0 0 66px;padding:20px 22px}.hv .tp p{font-size:16px}}
.hv .dab{max-width:760px;margin:18px auto 0;text-align:center;font-size:17px;line-height:1.6;color:var(--body)}
.hv .midcta{display:flex;flex-wrap:wrap;align-items:center;gap:14px 20px;margin:36px 0 0}
.hv .midcta>span{color:var(--mut);font-size:16px;text-wrap:balance}
.hv .how summary{text-wrap:balance}
/* hero */
.hv .hero{padding:96px 40px 88px}
.hv .hero .eb{color:#9ca3af;letter-spacing:2.2px}
.hv .hero .sub{font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;color:#fff;font-size:clamp(20px,1.9vw,26px);line-height:1.35;margin:22px 0 0;max-width:900px;text-wrap:balance}
.hv .split{display:grid;grid-template-columns:repeat(2,minmax(0,300px));gap:12px;margin:44px 0 0}
.hv .split .col{border-radius:10px;padding:22px 22px 20px;display:flex;flex-direction:column;gap:4px}
.hv .split .them{border:1px solid var(--dline);background:#1b1d24}
.hv .split .you{background:var(--o)}
.hv .split .lbl{font-size:14px;color:#c4c7cf}.hv .split .you .lbl{color:#fff}
.hv .split .bg{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(24px,2vw,28px);letter-spacing:-.8px;color:#fff;line-height:1.15}
.hv .split .them .bg{color:#e5e7eb}
.hv .hero .sol{font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;color:#fff;font-size:clamp(20px,1.8vw,24px);line-height:1.4;margin:40px 0 0}
.hv .hero>.in>.btn{margin:40px 0 0}
.hv .hero .alt{color:#c4c7cf;font-size:15px;margin:18px 0 0}
.hv .hero .alt a{color:var(--o);font-weight:700}.hv .hero .alt a:hover{color:var(--ol)}
.hv .hero .rating{display:inline-block;margin:18px 0 0;color:#c4c7cf;font-size:14px}.hv .hero .rating:hover{color:#fff}
.hv .hero .stars{color:var(--o);letter-spacing:2px;margin-right:4px}
.hv h1{font-weight:800;color:#fff;font-size:clamp(34px,4.4vw,58px);line-height:1.06;letter-spacing:-1.2px;margin:0 0 32px;max-width:940px}
/* services */
/* math */
.hv .cpb{border:1px solid var(--line);border-radius:14px;overflow:hidden;background:#fff}
.hv .cpb-h,.hv .cpb-r{display:grid;grid-template-columns:1fr 1.75fr .9fr .8fr}
.hv .cpb-h div{text-wrap:balance;font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:var(--mut);padding:16px 22px;background:var(--soft);border-bottom:1px solid var(--line)}
.hv .cpb-h div:nth-child(4){color:var(--o);background:var(--tint);border-left:3px solid var(--o)}
.hv .cpb-r div{padding:22px;font-size:17px;line-height:1.5;border-bottom:1px solid var(--line)}
.hv .cpb-r:last-child div{border-bottom:0}
.hv .cpb-r div:first-child{font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;color:var(--ink)}
.hv .cpb-r div:first-child small{display:block;font-family:'DM Sans',sans-serif;font-weight:400;color:var(--mut);font-size:15px}
.hv .cpb-r div:nth-child(3){font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:24px;color:var(--ink)}
.hv .cpb-r div:nth-child(4){background:#fff8f4;border-left:3px solid var(--o);font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(26px,2.3vw,32px);color:var(--ink);letter-spacing:-.6px}
.hv .cpb-r.best div:nth-child(4){color:var(--o)}
.hv .cpb .lab{display:none}
.hv .math{margin:20px 0 0;font-size:15px;color:var(--mut);line-height:1.6;max-width:900px}
.hv .read{margin:32px 0 0;font-size:18px;line-height:1.6;max-width:860px}
.hv .read b{color:var(--ink)}
.hv .calc{margin:64px 0 0;background:#fff;border:1px solid var(--line);border-radius:16px;padding:40px}
.hv .calc h3{font-size:clamp(22px,2.2vw,28px);margin:0 0 8px}
.hv .hero .sub .ln{display:block;text-wrap:balance}
.hv .calc .sub{color:var(--mut);font-size:16px;margin:0 0 28px}
.hv .chips{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 28px}
.hv .chips button{font:600 15px 'Plus Jakarta Sans',sans-serif;color:var(--ink);background:#fff;border:1px solid var(--line);border-radius:999px;padding:10px 16px;min-height:44px;cursor:pointer;transition:border-color .18s,background .18s,transform .18s}
.hv .chips button:hover{border-color:var(--o);transform:translateY(-2px)}
.hv .chips button[aria-pressed=true]{background:var(--tint);border-color:var(--o);color:var(--ink)}
.hv .cgrid{display:grid;grid-template-columns:1.3fr 1fr;gap:40px;align-items:start}
.hv .ins{display:grid;grid-template-columns:1fr 1fr;gap:26px 28px}
.hv .ins label{display:block;font-size:15px;color:var(--mut);margin-bottom:6px}
.hv .ins output{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:24px;color:var(--ink);margin-bottom:8px}
.hv .ins input[type=range]{width:100%;accent-color:var(--o);min-height:32px;cursor:pointer}
.hv .ins .opt-lab{font-size:13px;color:var(--mut)}
.hv .res{background:var(--tint);border-left:3px solid var(--o);border-radius:0 12px 12px 0;padding:26px 28px}
.hv .res .k{font-size:15px;color:var(--mut);margin:0 0 6px}
.hv .res .big{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(36px,3.6vw,48px);color:var(--o);letter-spacing:-1px;line-height:1;margin:0 0 6px;font-variant-numeric:tabular-nums}
.hv .res .big small{display:block;font-size:18px;letter-spacing:0;color:var(--ink);font-weight:700;margin-top:8px}
.hv .res .gp{font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:18px;color:var(--ink);margin:12px 0 0}
.hv .res .now{font-size:16px;margin:14px 0 0;padding-top:14px;border-top:1px solid #f3d6c8}
.hv .res .cap{font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:17px;color:var(--ink);margin:14px 0 0}
.hv .calc .fine{margin:24px 0 0;font-size:14px;line-height:1.6;color:var(--mut)}
/* leaks */
.hv .four{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
.hv .four div{background:#fff;border:1px solid var(--line);border-radius:14px;padding:28px 24px}
.hv .four b{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(22px,1.75vw,26px);white-space:nowrap;letter-spacing:-.5px;color:var(--o);line-height:1.05;margin-bottom:6px}
.hv .four h3{font-size:19px;margin:0 0 10px}
.hv .four p{font-size:16px;line-height:1.55}
.hv .four .src{display:block;color:var(--mut);font-size:13px;margin-top:10px}
.hv .cap3{margin:64px 0 0;display:grid;grid-template-columns:1fr 1.3fr;gap:40px;padding-top:48px;border-top:1px solid var(--line)}
.hv .cap3 h3{font-size:clamp(22px,2.2vw,28px)}
.hv .cap3 p{font-size:17px;line-height:1.65}
.hv .more{margin:40px 0 0;font-size:17px}
/* outcomes */
.hv .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.hv .steps>div{background:#fff;border:1px solid var(--line);border-radius:14px;padding:30px 26px;display:flex;flex-direction:column;transition:transform .18s,box-shadow .18s,border-color .18s}
.hv .steps>div:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(17,19,24,.08);border-color:var(--o)}
.hv .steps b{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:14px;font-weight:800;color:var(--o);letter-spacing:1.5px;margin-bottom:12px}
.hv .steps h3{margin-bottom:10px}
.hv .steps p{font-size:16px;line-height:1.6;flex:1}
.hv .steps .tl{margin-top:18px;font-size:16px}
/* record */
.hv .prov{color:#d1d5db;font-size:16px;line-height:1.6;max-width:860px;margin:0 0 22px}
.hv .prov b{color:#e5e7eb}
.hv .stats{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--dline);border-bottom:1px solid var(--dline);margin:0 0 28px}
.hv .stats div{padding:28px 12px 28px 0}
.hv .stats b{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(32px,3vw,44px);font-weight:800;color:#fff;letter-spacing:-1px;line-height:1;font-variant-numeric:tabular-nums}
.hv .stats b.o{color:var(--o)}
.hv .stats span{display:block;color:#c4c7cf;font-size:14px;margin-top:8px}
.hv .travel{color:#e5e7eb;font-size:18px;line-height:1.6;max-width:860px;margin:0;padding-bottom:8px}
.hv .adj{display:grid;grid-template-columns:1fr 1fr;gap:40px}
.hv .adj .k{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:#c4c7cf;margin:0 0 10px}
.hv .adj b{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(32px,3vw,42px);color:#fff;letter-spacing:-1px;line-height:1;margin:0 0 12px}
.hv .adj p{font-size:16px;line-height:1.6;color:#e5e7eb}
.hv .adj .src{display:block;color:#b8bcc6;font-size:14px;margin-top:8px}
.hv .anon{margin:32px 0 0;color:#b8bcc6;font-size:15px}
/* engage */
.hv .cmp{width:100%;border-collapse:separate;border-spacing:0;border:1px solid var(--line);border-radius:14px;overflow:hidden;margin:56px 0 0;font-size:16px}
.hv .cmp caption{text-align:left;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(22px,2.2vw,28px);color:var(--ink);padding:0 0 18px;text-wrap:balance;max-width:820px}
.hv .cmp th,.hv .cmp td{padding:18px 20px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line);line-height:1.5}
.hv .cmp thead th{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:700;letter-spacing:1.3px;text-transform:uppercase;color:var(--mut);background:var(--soft)}
.hv .cmp thead th:last-child{color:var(--o);background:var(--tint)}
.hv .cmp tbody th{font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;color:var(--ink);width:20%}
.hv .cmp td:last-child{background:#fff8f4;color:var(--ink);font-weight:600;border-left:3px solid var(--o)}
.hv .cmp tr:last-child th,.hv .cmp tr:last-child td{border-bottom:0}
.hv .need{margin:40px 0 0;background:var(--soft,#F8F8F8);border:1px solid #E0E0E0;border-left:4px solid #EF662F;border-radius:12px;padding:24px 28px}.hv .need b{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:18px;color:#333;margin-bottom:6px}.hv .need p{font-size:16px;line-height:1.6;margin:0;max-width:880px}
.hv .terms{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin:48px 0 56px}
.hv .terms div{font-size:16px;line-height:1.6;padding:18px 0 0;border-top:3px solid var(--o)}
.hv .terms b{color:var(--ink);display:block;text-wrap:balance;font-family:'Plus Jakarta Sans',sans-serif;font-size:18px;margin-bottom:4px}
.hv .price{margin:48px 0 0;display:grid;grid-template-columns:1fr 1fr;gap:32px;padding-top:40px;border-top:1px solid var(--line);align-items:start}
.hv .price p{font-size:17px;line-height:1.65}
.hv .price .diag{background:var(--tint);border-left:3px solid var(--o);padding:22px 24px;border-radius:0 12px 12px 0}
.hv .price .diag b{color:var(--ink);font-family:'Plus Jakarta Sans',sans-serif}
.hv .price .pr{color:var(--o);font-weight:800}
/* faq */
.hv .faq{max-width:860px}
.hv .faq details{border-bottom:1px solid var(--line)}
.hv .faq details:first-of-type{border-top:1px solid var(--line)}
.hv .faq summary{list-style:none;cursor:pointer;padding:22px 44px 22px 0;position:relative;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:19px;line-height:1.35;color:var(--ink);transition:color .18s}
.hv .faq summary::-webkit-details-marker{display:none}
.hv .faq summary::after{content:'+';position:absolute;right:4px;top:18px;color:var(--o);font-size:26px;font-weight:400;transition:transform .18s}
.hv .faq details[open] summary::after{transform:rotate(45deg)}
.hv .faq summary:hover{color:var(--o)}
.hv .faq .a{padding:0 0 24px;font-size:17px;line-height:1.65;max-width:800px}
/* close */
.hv .two{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin:8px 0 32px}
.hv .opt{background:#1d2028;border:1px solid var(--dline);border-radius:16px;padding:36px 34px;display:flex;flex-direction:column;transition:transform .18s,box-shadow .18s,border-color .18s}
.hv .opt:hover{transform:translateY(-3px);box-shadow:0 0 0 1px var(--o),0 16px 36px rgba(239,102,47,.18);border-color:var(--o)}
.hv .opt .tag{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#9ca3af;margin-bottom:10px}
.hv .opt h3{font-size:24px;margin:0 0 12px}
.hv .opt p{color:#c9ccd3;font-size:17px;line-height:1.6;flex:1;margin-bottom:24px}
.hv .opt .btn{align-self:flex-start}
.hv .fine2{color:#c9ccd3;font-size:16px;line-height:1.6;border-top:1px solid var(--dline);padding-top:24px}
.hv .closer h2{font-size:clamp(28px,3.1vw,42px)}
@media(max-width:1024px){.hv .path{grid-template-columns:1fr 1fr}.hv .path li:nth-child(3){border-left:0}.hv .path li:nth-child(n+3){border-top:1px solid var(--line)}.hv .path li:nth-child(2)::after{display:none}.hv .terms{grid-template-columns:1fr 1fr!important}.hv .four{grid-template-columns:1fr 1fr}.hv .stats{grid-template-columns:repeat(3,1fr)}.hv .stats div:nth-child(n+4){border-top:1px solid var(--dline)}.hv .cgrid{grid-template-columns:1fr}}
