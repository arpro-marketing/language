}
@media(max-width:700px){.hv .path{grid-template-columns:1fr}.hv .path li{border-left:0!important;border-top:1px solid var(--line)}.hv .path li:first-child{border-top:0}.hv .path li::after{display:none}.hv .terms{grid-template-columns:1fr!important}.hv .split{grid-template-columns:1fr;gap:10px;margin-top:32px}.hv .split .col{padding:16px 18px}.hv .hero .sol{margin-top:30px}.hv section{padding:64px 20px}.hv .hero{padding:52px 20px 48px}.hv .four{grid-template-columns:1fr}.hv .stats{grid-template-columns:1fr 1fr}.hv .stats div:nth-child(n+3){border-top:1px solid var(--dline)}.hv .stats div:last-child{grid-column:1/-1}.hv .hero .btn{width:100%;text-align:center}.hv .subnav{gap:4px 18px;font-size:14px}}
@media(max-width:400px){.hv .btn{font-size:16px;padding:15px 16px}.hv h1{font-size:33px}.hv .opt .btn,.hv .hero .btn{white-space:normal;width:100%;text-align:center;align-self:stretch}}
@media(prefers-reduced-motion:reduce){.hv *{transition:none!important;transform:none!important;animation:none!important}}

