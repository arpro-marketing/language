 .hv .cmp td::before{content:attr(data-l);display:block;font:700 13px 'Plus Jakarta Sans',sans-serif;letter-spacing:1.1px;text-transform:uppercase;color:var(--mut);margin-bottom:2px}
 .hv .cmp td:last-child{border-left:3px solid var(--o);margin:4px 0 12px}
