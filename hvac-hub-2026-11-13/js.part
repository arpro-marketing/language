<script>
(function(){
 var $=function(i){return document.getElementById(i)};
 var est=$('hvEst'),cr=$('hvCr'),job=$('hvJob'),gm=$('hvGm'),cost=$('hvCost'),cap=$('hvCapIn'),book=$('hvBook');if(!est)return;
 function m(n){return (n<0?'−$':'$')+Math.abs(Math.round(n)).toLocaleString('en-US')}
 function r1(n){return Math.round(n*10)/10}
 function go(){
  var e=+est.value,c=+cr.value,j=+job.value,g=+gm.value,k=+cap.value,mc=+cost.value,bk=+book.value;
  $('hvEstOut').textContent=e;$('hvCrOut').textContent=r1(c)+'%';$('hvJobOut').textContent=m(j);$('hvGmOut').textContent=g+'%';$('hvCostOut').textContent=m(mc);$('hvCapInOut').textContent=k;$('hvBookOut').textContent=bk;
  var sold=e*c/100,add=e*0.10,gp=add*j*12*g/100,net=gp-mc*12;
  $('hvGp').textContent='+'+m(gp);
  $('hvNet').textContent=mc>0?((net>=0?'+':'')+m(net)+' a year after '+m(mc)+' a month in marketing cost'):'Add a monthly cost to see profit after marketing.';
  $('hvNet').classList.toggle('over',net<0);
  $('hvAdd').textContent='From +'+m(add*j*12)+' a year in sold revenue at a '+g+'% margin';
  $('hvSold').textContent=r1(sold);$('hvNow').textContent=m(sold*j*g/100);
  var need=r1(sold+add+bk),el=$('hvCap'),pre=bk>0?('With '+bk+' install'+(bk===1?'':'s')+' already committed, that’s '):'That’s ';
  if(need<k){el.textContent=pre+need+' of your '+k+' a month. Your crews have room.';el.classList.remove('over')}
  else if(need===k){el.textContent=pre+need+' of your '+k+' a month. Your crews are full.';el.classList.remove('over')}
  else{el.textContent=pre+need+' installs a month, more than your crews’ '+k+'. Fix capacity before buying more marketing.';el.classList.add('over')}
  [].forEach.call(document.querySelectorAll('.hv .chips button'),function(b){b.setAttribute('aria-pressed',String(+b.dataset.v===j))});
 }
 [est,cr,job,gm,cost,cap,book].forEach(function(x){x.addEventListener('input',go)});
 [].forEach.call(document.querySelectorAll('.hv .chips button'),function(b){b.addEventListener('click',function(){job.value=b.dataset.v;go()})});
 go();
})();
</script>
