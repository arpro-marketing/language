<script>(function(){var r=document.querySelector('.hv .tline');if(!r)return;r.addEventListener('click',function(e){var b=e.target.closest('.tb button');if(!b)return;var open=b.getAttribute('aria-expanded')==='true';var mobile=window.matchMedia('(max-width:1100px)').matches;if(open){if(!mobile)return;}r.querySelectorAll('.tb button').forEach(function(x){x.setAttribute('aria-expanded','false');document.getElementById(x.getAttribute('aria-controls')).setAttribute('data-closed','')});if(!open){b.setAttribute('aria-expanded','true');document.getElementById(b.getAttribute('aria-controls')).removeAttribute('data-closed')}});})();</script>