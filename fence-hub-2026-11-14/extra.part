<style>
.fh .sv-measure .outs{list-style:none;margin:6px auto 0;padding:0;max-width:420px;text-align:left;display:grid;gap:8px}
.fh .sv-measure .outs li{color:#d1d5db;font-size:17px;line-height:1.45;padding-left:26px;position:relative}
.fh .sv-measure .outs li::before{content:'';position:absolute;left:4px;top:.5em;width:10px;height:10px;border-radius:50%;background:var(--o)}
.fh .tp .when{font-size:15px;color:#666;margin:12px 0 0}
.fh .tp .when b{color:#333}
.fh .rpt{margin:0 0 0}
.fh .rpt tbody th{width:24%}
.fh .rpt td{width:24%}
.fh .rpt td:nth-child(3){color:var(--ink)}
.fh .h3x{font-size:clamp(22px,2.2vw,28px);margin:72px 0 24px}
.fh .paths3{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.fh .paths3>div{background:#fff;border:1px solid var(--line);border-radius:14px;padding:28px 26px;display:flex;flex-direction:column;transition:transform .18s,box-shadow .18s,border-color .18s}
.fh .paths3>div:hover{transform:translateY(-4px);border-color:var(--o);box-shadow:0 22px 40px -22px rgba(20,25,38,.32)}
.fh .paths3 .tag{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:var(--o);margin:0 0 10px}
.fh .paths3 h4{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:19px;line-height:1.3;color:var(--ink);margin:0 0 10px;text-wrap:balance}
.fh .paths3 p{font-size:16px;line-height:1.55;flex:1;margin:0 0 16px}
.fh .quote{margin:8px 0 40px;padding:30px 34px;background:#1d2028;border:1px solid var(--dline);border-left:3px solid var(--o);border-radius:0 14px 14px 0;max-width:900px}
.fh .quote p{color:#e5e7eb;font-size:19px;line-height:1.6;margin:0 0 14px}
.fh .quote cite{font-style:normal;color:#b8bcc6;font-size:15px}
.fh .stats.s4x{grid-template-columns:repeat(4,1fr)}
.fh .travel a{white-space:nowrap}
.fh .notyet{display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:center;margin:72px 0 0}
.fh .notyet h3{font-size:clamp(22px,2.2vw,28px);margin:0 0 14px}
.fh .notyet p{font-size:17px;line-height:1.65;margin:0 0 14px}
.fh .notyet p b{color:var(--ink)}
.fh .season{margin:0;background:var(--soft);border:1px solid var(--line);border-radius:14px;padding:22px 22px 18px}
.fh .season svg{width:100%;height:auto;display:block;font-family:'Plus Jakarta Sans',sans-serif}
.fh .season figcaption{font-size:14px;line-height:1.55;color:var(--mut);margin-top:10px}
.fh .closer .fine2 a{white-space:nowrap}
.fh .hero .sol span{display:block}
.fh .sv-col{display:flex;flex-direction:column}
.fh .sv-col .sv-dcard{flex:1}
.fh .sv-fn{font-family:'Plus Jakarta Sans',sans-serif;font-size:15px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#333;text-align:center;margin:0 0 12px}
@media(max-width:700px){.fh .hero .sol span+span{margin-top:8px}}
.fh .paths3 .tag,.fh .opt .tag{flex:none}
@media(min-width:701px){.fh .guides a{white-space:nowrap}}
@media(max-width:1024px){.fh .stats.s4x{grid-template-columns:1fr 1fr}.fh .stats.s4x div:nth-child(n+3){border-top:1px solid var(--dline)}.fh .paths3{grid-template-columns:1fr}.fh .notyet{grid-template-columns:1fr;gap:28px}}
@media(max-width:700px){.fh .stats.s4x div:last-child{grid-column:auto}.fh .quote{padding:22px 20px}.fh .quote p{font-size:17px}.fh .rpt tbody th,.fh .rpt td{width:100%}.fh .h3x{margin-top:56px}}
</style>
<style>@media(max-width:700px){.fh .sv-col+.sv-col{margin-top:24px}}</style>
