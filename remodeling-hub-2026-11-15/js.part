<script>
(function(){
 var $=function(i){return document.getElementById(i)};
 var cpl=$('rmCpl'),cr=$('rmCr'),job=$('rmJob'),gm=$('rmGm');if(!cpl)return;
 function m(n){return '$'+Math.round(n).toLocaleString('en-US')}
 function go(){
  var l=+cpl.value,c=+cr.value,j=+job.value,g=+gm.value;
  $('rmCplOut').textContent=m(l);$('rmCrOut').textContent=c+'%';$('rmJobOut').textContent=m(j);$('rmGmOut').textContent=(Math.round(g*10)/10)+'%';
  var cpj=l/(c/100),gp=j*g/100,pct=Math.max(1,Math.round(cpj/gp*100)),one=Math.max(1,Math.round(100/c));
  $('rmCpj').textContent=m(cpj);
  $('rmOne').textContent=one===1?'About every inquiry becomes a project.':'About 1 in '+one+' inquiries becomes a project.';
  $('rmPct').textContent=pct+'% of the '+m(gp)+' gross profit on a '+m(j)+' project.';
  $('rmPct').classList.toggle('over',pct>=25);
  var s=l/0.10,o=l/0.33;
  $('rmCmp').textContent=c<20?('The same '+m(l)+' inquiry, owned and reached in five minutes at 33%, costs '+m(o)+' per booked project, '+Math.round(o/gp*100)+'% of that gross profit.'):('The same '+m(l)+' inquiry as a typical shared lead at 10% costs '+m(s)+' per booked project, '+Math.round(s/gp*100)+'% of that gross profit.');
  [].forEach.call(document.querySelectorAll('.rm .chips button'),function(b){b.setAttribute('aria-pressed',String(+b.dataset.v===c))});
 }
 [cpl,cr,job,gm].forEach(function(x){x.addEventListener('input',go)});
 [].forEach.call(document.querySelectorAll('.rm .chips button'),function(b){b.addEventListener('click',function(){cr.value=b.dataset.v;go()})});
 go();
})();
</script>
