<style>
/* live 11-14/15: funnel titles + two-paragraph intro */
.hv .sv-col{display:flex;flex-direction:column}
.hv .sv-col .sv-dcard{flex:1}
.hv .sv-fn{font-family:'Plus Jakarta Sans',sans-serif;font-size:15px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#333;text-align:center;margin:0 0 12px}
