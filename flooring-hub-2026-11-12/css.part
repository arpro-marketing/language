<style>
.fl{--o:#ef662f;--oh:#d4551f;--ol:#ff7a3d;--ink:#333333;--body:#333333;--mut:#666666;--soft:#f8f8f8;--tint:#fdf0eb;--line:#e0e0e0;--dark:#14161c;--dline:#2e313a;font-family:'DM Sans',sans-serif;color:var(--body)}
.fl *{box-sizing:border-box}
.fl section{padding:112px 40px}
.fl .in{max-width:1180px;margin:0 auto}
.fl p{margin:0;text-wrap:pretty}
.fl .big,.fl .lead{text-wrap:balance}
.fl a{color:var(--o);font-weight:700;text-decoration:none;transition:color .18s}
.fl a:hover{color:var(--oh)}
.fl .dark a:not(.btn):hover{color:var(--ol)}
.fl a:focus-visible,.fl button:focus-visible,.fl summary:focus-visible,.fl input:focus-visible{outline:3px solid var(--o);outline-offset:3px;border-radius:4px}
.fl a:active,.fl button:active{transform:translateY(1px)}
.fl .tl .ar{display:inline-block;transition:transform .18s;margin-left:2px}
.fl .tl:hover .ar{transform:translateX(4px)}
.fl .eb{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--o);margin:0 0 14px}
.fl h1,.fl h2,.fl h3{font-family:'Plus Jakarta Sans',sans-serif;color:var(--ink);margin:0;text-wrap:balance}
.fl h2{font-weight:800;font-size:clamp(30px,3.4vw,44px);line-height:1.1;letter-spacing:-.8px;margin:0 0 18px;max-width:900px}
.fl h2 .o,.fl h1 .o{color:var(--o)}
.fl h3{font-weight:800;font-size:21px;line-height:1.3}
.fl .lead{font-size:clamp(17px,1.4vw,19px);line-height:1.6;margin:0 0 44px;max-width:780px}
.fl .lead b{color:var(--ink)}
.fl .light{background:#fff}.fl .soft{background:var(--soft)}.fl .dark{background:var(--dark);color:#dfe2e7}
.fl .dark h1,.fl .dark h2,.fl .dark h3{color:#fff}.fl .dark .lead{color:#dfe2e7}.fl .dark .lead b{color:#fff}
.fl .btn{display:inline-block;background:var(--o);color:#fff!important;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:17px;padding:15px 24px;border-radius:8px;border:2px solid var(--o);transition:transform .18s,box-shadow .18s,background .18s;white-space:nowrap}
.fl .btn .ar{display:inline-block;transition:transform .18s;margin-left:4px}
.fl .btn:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(239,102,47,.32);background:var(--oh);border-color:var(--oh)}
.fl .btn:hover .ar{transform:translateX(4px)}
.fl .btn.ghost{background:transparent}
.fl .btn.ghost:hover{background:rgba(239,102,47,.12);border-color:var(--o)}
.fl .light .btn.ghost,.fl .soft .btn.ghost{color:var(--ink)!important}
.fl .illus{margin:0 0 18px;font-size:15px;color:var(--mut);line-height:1.5}.fl .illus b{color:var(--ink)}
.fl .cpb .pth{display:flex;flex-wrap:wrap;align-items:center;gap:2px 0;font-weight:500}.fl .cpb .pth i{font-style:normal;color:var(--o);font-weight:700;margin:0 8px}.fl .cpb .pth span:first-child i{display:none}.fl .cpb .pth span{white-space:nowrap}
.fl .take{margin:22px 0 0;font-size:17px;line-height:1.6;color:var(--body);max-width:900px}.fl .take b{color:var(--ink);font-weight:700}
.fl .how{margin:18px 0 0;max-width:900px}
.fl .how summary{cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:15px;color:var(--ink);display:inline-flex;align-items:center;gap:8px;padding:6px 0}
.fl .how summary::-webkit-details-marker{display:none}.fl .how summary::marker{content:''}
.fl .how summary::after{content:'+';color:var(--o);font-size:18px;line-height:1;transition:transform .18s}
.fl .how[open] summary::after{transform:rotate(45deg)}
.fl .how summary:hover{color:var(--o)}
.fl .how p{font-size:15px;color:var(--mut);line-height:1.6;margin:8px 0 0}
.fl .insight{margin:0;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(22px,2.2vw,30px);line-height:1.25;letter-spacing:-.5px;color:var(--ink);max-width:860px;text-wrap:balance}
.fl .read{margin:14px 0 0}
.fl .path{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:#fff}
.fl .path li{position:relative;padding:28px 26px 30px;border-left:1px solid var(--line);transition:background .18s}
.fl .path li:first-child{border-left:0}
.fl .path li:hover{background:var(--tint)}
.fl .path li:not(:last-child)::after{content:'';position:absolute;right:-9px;top:34px;width:16px;height:16px;background:inherit;border-top:1px solid var(--line);border-right:1px solid var(--line);transform:rotate(45deg);z-index:1;background:#fff}
.fl .path li:hover::after{background:var(--tint)}
.fl .path .st{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:var(--mut);margin-bottom:14px}
.fl .path b{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(21px,1.7vw,25px);letter-spacing:-.5px;color:var(--o);line-height:1.1;margin-bottom:8px}
.fl .path h3{font-size:18px;margin:0 0 10px}
.fl .path p{font-size:16px;line-height:1.55}
.fl .path .src{display:block;color:var(--mut);font-size:13px;margin-top:10px}
.fl .grp{font-family:'Plus Jakarta Sans',sans-serif;font-size:14px;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:var(--o);margin:48px 0 14px}
.fl #proof .lead+.grp{margin-top:36px}
.fl #system h2,.fl #system .lead{text-align:center;margin-left:auto;margin-right:auto}
.fl .sv-diag2{max-width:1000px;margin:48px auto 0}
.fl .sv-duo{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.fl .sv-dcard{background:#fff;border:1px solid #333;border-radius:14px;padding:34px 32px 28px;display:flex;flex-direction:column;transition:transform .18s,box-shadow .18s}
.fl .sv-dcard.team{border-color:var(--o)}
.fl .sv-dcard:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(17,19,24,.08)}
.fl .sv-dnum{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:var(--o);margin:0 0 14px}
.fl .sv-dcard h3{font-size:clamp(24px,2.2vw,30px);letter-spacing:-.6px;margin:0 0 18px}
.fl .sv-dlist{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:10px 24px;flex:1;align-content:start}
.fl .sv-dlist li{position:relative;padding-left:16px;font-size:17px}
.fl .sv-dlist li::before{content:'';position:absolute;left:0;top:.62em;width:6px;height:6px;background:var(--o)}
.fl .sv-dlist a{color:var(--ink);font-weight:500}.fl .sv-dlist a:hover{color:var(--o)}
.fl .sv-dwho{margin:22px 0 0;padding-top:18px;border-top:1px solid var(--line);font-size:15px;color:var(--mut);line-height:1.55}
.fl .sv-dwho b{display:block;color:var(--ink)}
.fl .sv-merge{display:block;width:100%;height:64px}
.fl .sv-stem{display:none}
.fl .sv-measure{background:#333;border-radius:14px;max-width:640px;margin:0 auto;padding:34px 32px;text-align:center;box-shadow:0 18px 40px rgba(17,19,24,.12)}
.fl .sv-measure .mk{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:var(--o);margin:0 0 10px}
.fl .sv-measure .mt{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(24px,2.3vw,30px);letter-spacing:-.6px;color:#fff;margin:0 0 10px;text-wrap:balance}
.fl .sv-measure .md{color:#d1d5db;font-size:17px;line-height:1.55;text-wrap:balance;max-width:440px;margin:0 auto}
.fl .sv-dcap{text-align:center;color:var(--mut);font-size:17px;margin:28px 0 0}
.fl .sv-dmore{text-align:center;margin:12px 0 0;font-size:17px}
@media(max-width:700px){.fl .sv-duo{grid-template-columns:1fr;gap:14px}.fl .sv-merge{display:none}.fl .sv-stem{display:block;width:2px;height:36px;background:var(--o);margin:0 auto}.fl .sv-dcard{padding:26px 22px 22px}.fl .sv-measure{padding:28px 22px}}
.fl .tlax{display:flex;justify-content:space-between;font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:var(--mut);margin:48px 0 14px}
.fl .tlax span:last-child{color:var(--o)}
.fl .tline{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(7,1fr);gap:0 16px;position:relative}
.fl .tline::before{content:'';position:absolute;left:0;right:0;top:21px;height:4px;border-radius:2px;background:linear-gradient(90deg,var(--line),var(--o))}
.fl .tn{position:relative;z-index:1;display:grid;place-items:center;width:46px;height:46px;border-radius:50%;background:#fff;border:2px solid var(--o);font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:15px;color:var(--o);margin-bottom:18px;transition:background .18s,color .18s,box-shadow .18s}
.fl .tline li{display:contents}
.fl .tb{margin:0;font-size:inherit}
.fl .tb button{all:unset;box-sizing:border-box;cursor:pointer;display:flex;flex-direction:column;align-items:flex-start;width:100%;height:100%;padding:0 4px 18px;border-radius:10px;transition:transform .18s}
.fl .tb button:hover{transform:translateY(-3px)}
.fl .tb button:focus-visible{outline:2px solid var(--o);outline-offset:4px}
.fl .tb button:hover .tn,.fl .tb button[aria-expanded="true"] .tn{background:var(--o);color:#fff;box-shadow:0 0 0 6px var(--tint)}
.fl .tw{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:14px;font-weight:800;color:var(--o);margin:0 0 6px}
.fl .th{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:17px;line-height:1.3;color:var(--ink);margin:0 0 8px;text-wrap:balance}
.fl .tb button[aria-expanded="true"] .th{color:var(--o)}
.fl .tx{display:block;font-family:'DM Sans',sans-serif;font-weight:400;font-size:15px;color:var(--mut);line-height:1.45}
.fl .tp{grid-column:1/-1;grid-row:2;margin:18px 0 0;background:var(--tint);border-left:3px solid var(--o);border-radius:0 12px 12px 0;padding:26px 30px;animation:tpIn .25s ease}
.fl .tp[data-closed]{display:none}
.fl .tp p{font-size:17px;line-height:1.65;max-width:860px}
.fl .tp .tsrc{font-size:13px;line-height:1.5;color:#666;margin:12px 0 0}
.fl .tp .tph{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#333;margin:0 0 6px}
.fl .tp .tpw{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:var(--o);margin:0 0 8px}
@keyframes tpIn{from{opacity:.4;transform:translateY(4px)}to{opacity:1;transform:none}}
.fl .tlhint{margin:16px 0 0;font-size:15px;color:var(--mut)}
@media(max-width:1100px){.fl .tlax{display:none}.fl .tline{grid-template-columns:1fr;gap:0;margin-top:40px}.fl .tline::before{left:21px;right:auto;top:0;bottom:0;width:4px;height:auto;background:linear-gradient(180deg,var(--line),var(--o))}.fl .tline li{display:block;position:relative;padding:0 0 22px}.fl .tline li:last-child{padding-bottom:0}.fl .tb button{display:grid;grid-template-columns:46px 1fr;column-gap:20px;padding:0;align-items:start}.fl .tn{grid-row:1/4;margin:0}.fl .tw,.fl .th,.fl .tx{grid-column:2}.fl .tb button:hover{transform:translateX(3px)}.fl .th{font-size:19px}.fl .tp{grid-row:auto;margin:14px 0 0 66px;padding:20px 22px}.fl .tp p{font-size:16px}}
.fl .dab{max-width:760px;margin:18px auto 0;text-align:center;font-size:17px;line-height:1.6;color:var(--body)}
.fl .midcta{display:flex;flex-wrap:wrap;align-items:center;gap:14px 20px;margin:36px 0 0}
.fl .midcta>span{color:var(--mut);font-size:16px;text-wrap:balance}
.fl .how summary{text-wrap:balance}
/* hero */
.fl .hero{padding:96px 40px 88px}
.fl .hero .eb{color:#9ca3af;letter-spacing:2.2px}
.fl .hero .sub{font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;color:#fff;font-size:clamp(20px,1.9vw,26px);line-height:1.35;margin:22px 0 0;max-width:900px;text-wrap:balance}
.fl .split{display:grid;grid-template-columns:repeat(2,minmax(0,300px));gap:12px;margin:44px 0 0}
.fl .split .col{border-radius:10px;padding:22px 22px 20px;display:flex;flex-direction:column;gap:4px}
.fl .split .them{border:1px solid var(--dline);background:#1b1d24}
.fl .split .you{background:var(--o)}
.fl .split .lbl{font-size:14px;color:#c4c7cf}.fl .split .you .lbl{color:#fff}
.fl .split .bg{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(24px,2vw,28px);letter-spacing:-.8px;color:#fff;line-height:1.15}
.fl .split .them .bg{color:#e5e7eb}
.fl .hero .sol{font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;color:#fff;font-size:clamp(20px,1.8vw,24px);line-height:1.4;margin:40px 0 0}
.fl .hero>.in>.btn{margin:40px 0 0}
.fl .hero .alt{color:#c4c7cf;font-size:15px;margin:18px 0 0}
.fl .hero .alt a{color:var(--o);font-weight:700}.fl .hero .alt a:hover{color:var(--ol)}
.fl .hero .rating{display:inline-block;margin:18px 0 0;color:#c4c7cf;font-size:14px}.fl .hero .rating:hover{color:#fff}
.fl .hero .stars{color:var(--o);letter-spacing:2px;margin-right:4px}
.fl h1{font-weight:800;color:#fff;font-size:clamp(34px,4.4vw,58px);line-height:1.06;letter-spacing:-1.2px;margin:0 0 32px;max-width:940px}
/* services */
/* math */
.fl .cpb{border:1px solid var(--line);border-radius:14px;overflow:hidden;background:#fff}
.fl .cpb-h,.fl .cpb-r{display:grid;grid-template-columns:1fr 1.75fr .9fr .8fr}
.fl .cpb-h div{text-wrap:balance;font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:var(--mut);padding:16px 22px;background:var(--soft);border-bottom:1px solid var(--line)}
.fl .cpb-h div:nth-child(4){color:var(--o);background:var(--tint);border-left:3px solid var(--o)}
.fl .cpb-r div{padding:22px;font-size:17px;line-height:1.5;border-bottom:1px solid var(--line)}
.fl .cpb-r:last-child div{border-bottom:0}
.fl .cpb-r div:first-child{font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;color:var(--ink)}
.fl .cpb-r div:first-child small{display:block;font-family:'DM Sans',sans-serif;font-weight:400;color:var(--mut);font-size:15px}
.fl .cpb-r div:nth-child(3){font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:24px;color:var(--ink)}
.fl .cpb-r div:nth-child(4){background:#fff8f4;border-left:3px solid var(--o);font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(26px,2.3vw,32px);color:var(--ink);letter-spacing:-.6px}
.fl .cpb-r.best div:nth-child(4){color:var(--o)}
.fl .cpb .lab{display:none}
.fl .math{margin:20px 0 0;font-size:15px;color:var(--mut);line-height:1.6;max-width:900px}
.fl .read{margin:32px 0 0;font-size:18px;line-height:1.6;max-width:860px}
.fl .read b{color:var(--ink)}
.fl .calc{margin:64px 0 0;background:#fff;border:1px solid var(--line);border-radius:16px;padding:40px}
.fl .calc h3{font-size:clamp(22px,2.2vw,28px);margin:0 0 8px}
.fl .hero .sub .ln{display:block;text-wrap:balance}
.fl .calc .sub{color:var(--mut);font-size:16px;margin:0 0 28px}
.fl .chips{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 28px}
.fl .chips button{font:600 15px 'Plus Jakarta Sans',sans-serif;color:var(--ink);background:#fff;border:1px solid var(--line);border-radius:999px;padding:10px 16px;min-height:44px;cursor:pointer;transition:border-color .18s,background .18s,transform .18s}
.fl .chips button:hover{border-color:var(--o);transform:translateY(-2px)}
.fl .chips button[aria-pressed=true]{background:var(--tint);border-color:var(--o);color:var(--ink)}
.fl .cgrid{display:grid;grid-template-columns:1.3fr 1fr;gap:40px;align-items:start}
.fl .ins{display:grid;grid-template-columns:1fr 1fr;gap:26px 28px}
.fl .ins label{display:block;font-size:15px;color:var(--mut);margin-bottom:6px}
.fl .ins output{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:24px;color:var(--ink);margin-bottom:8px}
.fl .ins input[type=range]{width:100%;accent-color:var(--o);min-height:32px;cursor:pointer}
.fl .ins .opt-lab{font-size:13px;color:var(--mut)}
.fl .res{background:var(--tint);border-left:3px solid var(--o);border-radius:0 12px 12px 0;padding:26px 28px}
.fl .res .k{font-size:15px;color:var(--mut);margin:0 0 6px}
.fl .res .big{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(36px,3.6vw,48px);color:var(--o);letter-spacing:-1px;line-height:1;margin:0 0 6px;font-variant-numeric:tabular-nums}
.fl .res .big small{display:block;font-size:18px;letter-spacing:0;color:var(--ink);font-weight:700;margin-top:8px}
.fl .res .gp{font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:18px;color:var(--ink);margin:12px 0 0}
.fl .res .now{font-size:16px;margin:14px 0 0;padding-top:14px;border-top:1px solid #f3d6c8}
.fl .res .cap{font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:17px;color:var(--ink);margin:14px 0 0}
.fl .calc .fine{margin:24px 0 0;font-size:14px;line-height:1.6;color:var(--mut)}
/* leaks */
.fl .four{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
.fl .four div{background:#fff;border:1px solid var(--line);border-radius:14px;padding:28px 24px}
.fl .four b{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(22px,1.75vw,26px);white-space:nowrap;letter-spacing:-.5px;color:var(--o);line-height:1.05;margin-bottom:6px}
.fl .four h3{font-size:19px;margin:0 0 10px}
.fl .four p{font-size:16px;line-height:1.55}
.fl .four .src{display:block;color:var(--mut);font-size:13px;margin-top:10px}
.fl .cap3{margin:64px 0 0;display:grid;grid-template-columns:1fr 1.3fr;gap:40px;padding-top:48px;border-top:1px solid var(--line)}
.fl .cap3 h3{font-size:clamp(22px,2.2vw,28px)}
.fl .cap3 p{font-size:17px;line-height:1.65}
.fl .more{margin:40px 0 0;font-size:17px}
/* outcomes */
.fl .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.fl .steps>div{background:#fff;border:1px solid var(--line);border-radius:14px;padding:30px 26px;display:flex;flex-direction:column;transition:transform .18s,box-shadow .18s,border-color .18s}
.fl .steps>div:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(17,19,24,.08);border-color:var(--o)}
.fl .steps b{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:14px;font-weight:800;color:var(--o);letter-spacing:1.5px;margin-bottom:12px}
.fl .steps h3{margin-bottom:10px}
.fl .steps p{font-size:16px;line-height:1.6;flex:1}
.fl .steps .tl{margin-top:18px;font-size:16px}
/* record */
.fl .prov{color:#d1d5db;font-size:16px;line-height:1.6;max-width:860px;margin:0 0 22px}
.fl .prov b{color:#e5e7eb}
.fl .stats{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--dline);border-bottom:1px solid var(--dline);margin:0 0 28px}
.fl .stats div{padding:28px 12px 28px 0}
.fl .stats b{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(32px,3vw,44px);font-weight:800;color:#fff;letter-spacing:-1px;line-height:1;font-variant-numeric:tabular-nums}
.fl .stats b.o{color:var(--o)}
.fl .stats span{display:block;color:#c4c7cf;font-size:14px;margin-top:8px}
.fl .travel{color:#e5e7eb;font-size:18px;line-height:1.6;max-width:860px;margin:0;padding-bottom:8px}
.fl .adj{display:grid;grid-template-columns:1fr 1fr;gap:40px}
.fl .adj .k{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:#c4c7cf;margin:0 0 10px}
.fl .adj b{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(32px,3vw,42px);color:#fff;letter-spacing:-1px;line-height:1;margin:0 0 12px}
.fl .adj p{font-size:16px;line-height:1.6;color:#e5e7eb}
.fl .adj .src{display:block;color:#b8bcc6;font-size:14px;margin-top:8px}
.fl .anon{margin:32px 0 0;color:#b8bcc6;font-size:15px}
/* engage */
.fl .cmp{width:100%;border-collapse:separate;border-spacing:0;border:1px solid var(--line);border-radius:14px;overflow:hidden;margin:56px 0 0;font-size:16px}
.fl .cmp caption{text-align:left;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:clamp(22px,2.2vw,28px);color:var(--ink);padding:0 0 18px;text-wrap:balance;max-width:820px}
.fl .cmp th,.fl .cmp td{padding:18px 20px;text-align:left;vertical-align:top;border-bottom:1px solid var(--line);line-height:1.5}
.fl .cmp thead th{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:700;letter-spacing:1.3px;text-transform:uppercase;color:var(--mut);background:var(--soft)}
.fl .cmp thead th:last-child{color:var(--o);background:var(--tint)}
.fl .cmp tbody th{font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;color:var(--ink);width:20%}
.fl .cmp td:last-child{background:#fff8f4;color:var(--ink);font-weight:600;border-left:3px solid var(--o)}
.fl .cmp tr:last-child th,.fl .cmp tr:last-child td{border-bottom:0}
.fl .need{margin:40px 0 0;background:var(--soft,#F8F8F8);border:1px solid #E0E0E0;border-left:4px solid #EF662F;border-radius:12px;padding:24px 28px}.fl .need b{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:18px;color:#333;margin-bottom:6px}.fl .need p{font-size:16px;line-height:1.6;margin:0;max-width:880px}
.fl .terms{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin:48px 0 56px}
.fl .terms div{font-size:16px;line-height:1.6;padding:18px 0 0;border-top:3px solid var(--o)}
.fl .terms b{color:var(--ink);display:block;text-wrap:balance;font-family:'Plus Jakarta Sans',sans-serif;font-size:18px;margin-bottom:4px}
.fl .price{margin:48px 0 0;display:grid;grid-template-columns:1fr 1fr;gap:32px;padding-top:40px;border-top:1px solid var(--line);align-items:start}
.fl .price p{font-size:17px;line-height:1.65}
.fl .price .diag{background:var(--tint);border-left:3px solid var(--o);padding:22px 24px;border-radius:0 12px 12px 0}
.fl .price .diag b{color:var(--ink);font-family:'Plus Jakarta Sans',sans-serif}
.fl .price .pr{color:var(--o);font-weight:800}
/* faq */
.fl .faq{max-width:860px}
.fl .faq details{border-bottom:1px solid var(--line)}
.fl .faq details:first-of-type{border-top:1px solid var(--line)}
.fl .faq summary{list-style:none;cursor:pointer;padding:22px 44px 22px 0;position:relative;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:19px;line-height:1.35;color:var(--ink);transition:color .18s}
.fl .faq summary::-webkit-details-marker{display:none}
.fl .faq summary::after{content:'+';position:absolute;right:4px;top:18px;color:var(--o);font-size:26px;font-weight:400;transition:transform .18s}
.fl .faq details[open] summary::after{transform:rotate(45deg)}
.fl .faq summary:hover{color:var(--o)}
.fl .faq .a{padding:0 0 24px;font-size:17px;line-height:1.65;max-width:800px}
/* close */
.fl .two{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin:8px 0 32px}
.fl .opt{background:#1d2028;border:1px solid var(--dline);border-radius:16px;padding:36px 34px;display:flex;flex-direction:column;transition:transform .18s,box-shadow .18s,border-color .18s}
.fl .opt:hover{transform:translateY(-3px);box-shadow:0 0 0 1px var(--o),0 16px 36px rgba(239,102,47,.18);border-color:var(--o)}
.fl .opt .tag{font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#9ca3af;margin-bottom:10px}
.fl .opt h3{font-size:24px;margin:0 0 12px}
.fl .opt p{color:#c9ccd3;font-size:17px;line-height:1.6;flex:1;margin-bottom:24px}
.fl .opt .btn{align-self:flex-start}
.fl .fine2{color:#c9ccd3;font-size:16px;line-height:1.6;border-top:1px solid var(--dline);padding-top:24px}
.fl .closer h2{font-size:clamp(28px,3.1vw,42px)}
@media(max-width:1024px){.fl .path{grid-template-columns:1fr 1fr}.fl .path li:nth-child(3){border-left:0}.fl .path li:nth-child(n+3){border-top:1px solid var(--line)}.fl .path li:nth-child(2)::after{display:none}.fl .terms{grid-template-columns:1fr 1fr!important}.fl .four{grid-template-columns:1fr 1fr}.fl .stats{grid-template-columns:repeat(3,1fr)}.fl .stats div:nth-child(n+4){border-top:1px solid var(--dline)}.fl .cgrid{grid-template-columns:1fr}}
@media(max-width:820px){
 .fl section{padding:72px 40px}.fl .hero{padding:64px 40px 56px}
 .fl .cpb-h{display:none}
 .fl .cpb-r{grid-template-columns:1fr 1fr;padding:18px 20px;border-bottom:1px solid var(--line)}
 .fl .cpb-r:last-child{border-bottom:0}
 .fl .cpb-r div{padding:4px 0;border:0!important}
 .fl .cpb-r div:first-child,.fl .cpb-r div:nth-child(2){grid-column:1/-1}
 .fl .cpb-r div:nth-child(4){background:#fff8f4;border-left:3px solid var(--o)!important;padding:8px 12px;border-radius:0 8px 8px 0}
 .fl .cpb .lab{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:13px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:var(--mut);margin:8px 0 2px}
 .fl .calc{padding:28px 22px}
 .fl .ins{grid-template-columns:1fr}
 .fl .cap3,.fl .steps,.fl .adj,.fl .two,.fl .terms,.fl .price{grid-template-columns:1fr}
 .fl .opt{padding:28px 24px}
 .fl .cmp thead{display:none}
 .fl .cmp caption{display:block;width:auto;max-width:none;padding:0 0 16px}
 .fl .cmp{border:0;border-radius:0;overflow:visible}
 .fl .cmp tbody{border:1px solid var(--line);border-radius:14px;overflow:hidden}
 .fl .cmp,.fl .cmp tbody,.fl .cmp tr,.fl .cmp th,.fl .cmp td{display:block;width:100%}
 .fl .cmp tr{border-bottom:1px solid var(--line);padding:6px 0}
 .fl .cmp tr:last-child{border-bottom:0}
 .fl .cmp tbody th{width:100%;padding:16px 18px 6px;border:0}
 .fl .cmp td{border:0;padding:6px 18px}
 .fl .cmp td::before{content:attr(data-l);display:block;font:700 13px 'Plus Jakarta Sans',sans-serif;letter-spacing:1.1px;text-transform:uppercase;color:var(--mut);margin-bottom:2px}
 .fl .cmp td:last-child{border-left:3px solid var(--o);margin:4px 0 12px}
 .fl .cmp td:last-child::before{color:var(--o)}
}
@media(max-width:700px){.fl .path{grid-template-columns:1fr}.fl .path li{border-left:0!important;border-top:1px solid var(--line)}.fl .path li:first-child{border-top:0}.fl .path li::after{display:none}.fl .terms{grid-template-columns:1fr!important}.fl .split{grid-template-columns:1fr;gap:10px;margin-top:32px}.fl .split .col{padding:16px 18px}.fl .hero .sol{margin-top:30px}.fl section{padding:64px 20px}.fl .hero{padding:52px 20px 48px}.fl .four{grid-template-columns:1fr}.fl .stats{grid-template-columns:1fr 1fr}.fl .stats div:nth-child(n+3){border-top:1px solid var(--dline)}.fl .stats div:last-child{grid-column:1/-1}.fl .hero .btn{width:100%;text-align:center}.fl .subnav{gap:4px 18px;font-size:14px}}
@media(max-width:400px){.fl .btn{font-size:16px;padding:15px 16px}.fl h1{font-size:33px}.fl .opt .btn,.fl .hero .btn{white-space:normal;width:100%;text-align:center;align-self:stretch}}
@media(prefers-reduced-motion:reduce){.fl *{transition:none!important;transform:none!important;animation:none!important}}

.fl .steps.s4{grid-template-columns:repeat(4,1fr)}
.fl .bjm{margin:0 0 18px;font-family:'Plus Jakarta Sans',sans-serif;font-size:14px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:var(--mut)}
.fl .guides{margin:40px 0 0;padding-top:28px;border-top:1px solid var(--line);font-size:16px;line-height:1.9;max-width:860px}
.fl .guides b{font-family:'Plus Jakarta Sans',sans-serif;color:var(--ink);margin-right:6px}
.fl .guides a{color:var(--ink);text-decoration:underline;text-decoration-color:var(--line);text-underline-offset:3px;transition:color .15s,text-decoration-color .15s}
.fl .guides a:hover{color:var(--o);text-decoration-color:var(--o)}
.fl .guides span{color:var(--mut);margin:0 8px}
@media(max-width:1100px){.fl .steps.s4{grid-template-columns:1fr 1fr}}
@media(max-width:700px){.fl .steps.s4{grid-template-columns:1fr}}
.fl .prov{color:#e5e7eb}.fl .stats span{color:#d9dce2;font-size:15px}.fl .adj .k{color:#d9dce2}.fl .anon{color:#cfd3da}.fl .dark .lead{color:#eef0f3}
.fl .cmp th,.fl .cmp td{padding:14px 20px}
@media print{.fl section{-webkit-print-color-adjust:exact;print-color-adjust:exact}}
</style>
